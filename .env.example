# local: PostgreSQL persistente embebido, un solo proceso, solo desarrollo.
# supabase: Auth y PostgreSQL del proyecto configurado.
SOCKIT_DATABASE_MODE=local
# Configura una contraseña de al menos 12 caracteres y un secreto aleatorio >=32.
SOCKIT_LOCAL_PASSWORD=
SOCKIT_SESSION_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Dominio HTTPS del despliegue para recuperación de contraseña.
NEXT_PUBLIC_SITE_URL=
# Opcionales: rutas locales separadas para bases/restauraciones/pruebas.
# SOCKIT_LOCAL_DB_DIR=.sockit/postgres
# SOCKIT_LOCAL_FILES_DIR=.sockit/uploads

# En Vercel, referencia del proyecto autorizado (distingue prueba de producción).
SOCKIT_EXPECTED_SUPABASE_PROJECT=
# Solo true en un despliegue de prueba claramente identificado.
SOCKIT_DEMO_MODE=false
